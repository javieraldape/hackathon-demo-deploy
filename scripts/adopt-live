#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
[[ $# -le 1 ]] || { echo 'Usage: scripts/adopt-live [existing-qm-database-name]' >&2; exit 2; }
require docker; require node; require python3
running "$DB_NAME" || { echo 'Expected running existing qm-dev-postgres container' >&2; exit 1; }
[[ "$(docker port "$DB_NAME" 5432/tcp)" = '127.0.0.1:55432' ]] || {
  echo 'Existing PostgreSQL port is not loopback-only' >&2; exit 1
}
[[ ! -e "$DEMO_RUNTIME_ROOT/credentials/postgres.env" && ! -e "$QM_DEV_ENV" ]] || {
  echo 'Private database env files already exist; refusing overwrite or rotation' >&2; exit 1
}
require_private "$DEMO_RUNTIME_ROOT/credentials/codex/auth.json"
[[ "$(git -C "$QM_SOURCE" rev-parse HEAD 2>/dev/null)" = "$QM_COMMIT" ]] || {
  echo 'Pinned QM checkout required before adopting live database' >&2; exit 1
}
python3 - "$DB_NAME" "$DEMO_RUNTIME_ROOT/credentials" "${1:-}" <<'PY'
import json, os, pathlib, subprocess, sys, urllib.parse
container, credentials, selected = sys.argv[1:]
def docker(*args):
    return subprocess.check_output(['docker', *args], stderr=subprocess.DEVNULL, text=True).strip()
env = dict(item.split('=', 1) for item in json.loads(docker('inspect', '--format', '{{json .Config.Env}}', container)) if '=' in item)
password = env.get('POSTGRES_PASSWORD', '')
user = env.get('POSTGRES_USER') or 'postgres'
if not password or any(c in password for c in '\r\n') or any(c in user for c in '\r\n'):
    raise SystemExit('Existing PostgreSQL credentials are unavailable or invalid')
databases = docker('exec', container, 'psql', '-U', user, '-d', 'postgres', '-Atqc',
                   "SELECT datname FROM pg_database WHERE datname = 'qm' OR datname LIKE 'qm_dev_%' ORDER BY datname").splitlines()
if selected and selected not in databases:
    raise SystemExit('Selected QM database does not exist in the container')
if not selected:
    if len(databases) != 1:
        raise SystemExit('Multiple or no QM databases found; supply the exact database name as an argument')
    selected = databases[0]
url = 'postgresql://' + urllib.parse.quote(user, safe='') + ':' + urllib.parse.quote(password, safe='') + '@127.0.0.1:55432/' + urllib.parse.quote(selected, safe='')
root = pathlib.Path(credentials)
root.mkdir(parents=True, exist_ok=True, mode=0o700)
os.chmod(root, 0o700)
for name, body in (
    ('postgres.env', f'POSTGRES_USER={user}\nPOSTGRES_DB={env.get("POSTGRES_DB") or "postgres"}\nPOSTGRES_PASSWORD={password}\n'),
    ('qm.env', f'DATABASE_URL={url}\nHARNESS=codex\nCODEX_AUTH_FILE={root}/codex/auth.json\n'),
):
    fd = os.open(root / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as out:
        out.write(body)
PY
if ! node - "$QM_SOURCE" "$QM_DEV_ENV" <<'JS' >/dev/null 2>&1
const fs = require('node:fs');
const [source, envPath] = process.argv.slice(2);
const line = fs.readFileSync(envPath, 'utf8').split('\n').find(value => value.startsWith('DATABASE_URL='));
if (!line) process.exit(1);
const { Client } = require(`${source}/node_modules/pg`);
(async () => {
  const client = new Client({ connectionString: line.slice('DATABASE_URL='.length) });
  try { await client.connect(); await client.query('SELECT 1'); }
  finally { await client.end(); }
})().catch(() => process.exit(1));
JS
then
  rm -f "$DEMO_RUNTIME_ROOT/credentials/postgres.env" "$QM_DEV_ENV"
  echo 'Database connection verification failed; adoption files removed, live DB unchanged' >&2; exit 1
fi
echo 'Adopted existing QM database credentials privately; verified connection without changing the database.'
