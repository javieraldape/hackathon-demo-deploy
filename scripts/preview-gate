#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
require bun
[[ $# = 0 ]] || { echo 'Usage: SCOPED_GATE_CONFIG=/private/config.json scripts/preview-gate' >&2; exit 2; }
[[ -n "${SCOPED_GATE_CONFIG:-}" ]] || { echo 'Set SCOPED_GATE_CONFIG to an external private identity-gate JSON file' >&2; exit 1; }
exec bun "$REPO_ROOT/scripts/run-scoped-preview.ts"
