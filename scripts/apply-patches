#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def git_apply(root, patch, *options):
    return subprocess.run(
        ["git", "apply", "--whitespace=nowarn", *options, str(patch)],
        cwd=root, capture_output=True,
        env={**os.environ, "GIT_CEILING_DIRECTORIES": str(root.parent)},
    )


def apply_patches(target, patches):
    target = Path(target).resolve(strict=True)
    patches = [Path(patch).resolve(strict=True) for patch in patches]
    if not target.is_dir() or not patches:
        raise ValueError("Supply a source directory and at least one patch")
    with tempfile.TemporaryDirectory(prefix="demo-patches-") as temporary:
        root = Path(temporary)
        paths = set()
        for patch in patches:
            result = git_apply(root, patch, "--numstat", "-z")
            if result.returncode or not result.stdout:
                raise ValueError(f"Invalid or empty patch: {patch.name}")
            for entry in result.stdout.rstrip(b"\0").split(b"\0"):
                _, _, name = entry.decode().split("\t", 2)
                path = Path(name)
                if path.is_absolute() or ".." in path.parts or ".git" in path.parts:
                    raise ValueError("Patch contains an unsafe path")
                source = target / path
                if any(part.is_symlink() for part in [source, *source.parents]):
                    raise ValueError("Patch target contains a symlink")
                if source.exists() and not source.is_file():
                    raise ValueError("Patch target is not a regular file")
                paths.add(path)
        before = {path: ((target / path).read_bytes() if (target / path).exists() else None) for path in paths}

        def stage(reverse=False):
            work = root / ("reverse" if reverse else "forward")
            work.mkdir()
            for path in paths:
                if before[path] is not None:
                    (work / path).parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(target / path, work / path)
            for patch in reversed(patches) if reverse else patches:
                result = git_apply(work, patch, *(["--reverse"] if reverse else []))
                if result.returncode:
                    return None
            return work

        work = stage()
        if work is None:
            if stage(reverse=True) is not None:
                return "already applied"
            raise ValueError("Patch series does not match source; no files changed (partial application or source drift)")
        for path in paths:
            current = (target / path).read_bytes() if (target / path).exists() else None
            if current != before[path]:
                raise ValueError("Source changed during patch validation; no files changed")
        for path in sorted(paths):
            destination = target / path
            if not (work / path).exists():
                destination.unlink()
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            descriptor, pending = tempfile.mkstemp(prefix=".patch-", dir=destination.parent)
            os.close(descriptor)
            try:
                shutil.copy2(work / path, pending)
                os.replace(pending, destination)
            finally:
                Path(pending).unlink(missing_ok=True)
        return "applied"


def main():
    if len(sys.argv) < 3:
        raise SystemExit("Usage: scripts/apply-patches SOURCE PATCH [PATCH ...]")
    try:
        result = apply_patches(sys.argv[1], sys.argv[2:])
    except (OSError, ValueError) as error:
        raise SystemExit(str(error)) from None
    print(f"Pinned patch series: {result}")


if __name__ == "__main__":
    main()
