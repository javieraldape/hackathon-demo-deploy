# Private runtime file: $DEMO_RUNTIME_ROOT/credentials/qm.env (mode 0600).
# install creates DATABASE_URL using the private PostgreSQL password on host loopback.
# The restored DB should already contain the Mac MCP registration and admin_grants.
DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:55432/qm
HARNESS=codex
CODEX_AUTH_FILE=/absolute/private/stage/credentials/codex/auth.json
# Optional: choose the existing admin_grants principal to use for localhost bypass.
# DEV_INSTANCE_ADMIN_PRINCIPAL=existing-principal
# The host dev-instance provides the localhost portal and local Docker sandbox.
