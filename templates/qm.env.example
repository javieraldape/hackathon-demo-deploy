# Private runtime file: $DEMO_RUNTIME_ROOT/credentials/qm.env (mode 0600).
# install creates DATABASE_URL using the private PostgreSQL password on host loopback.
DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:55432/qm
HARNESS=codex
CODEX_AUTH_FILE=/absolute/private/stage/credentials/codex/auth.json
PORTAL_LOCAL_AUTH_BYPASS=0
PORTAL_PLAYGROUND=0
ALLOW_UNSIGNED_TEST_IDENTITY=0
REQUIRE_SIGNED_PORTAL_IDENTITY=1
WEB_UI_PRINCIPALS=admin-principal,intern-principal
