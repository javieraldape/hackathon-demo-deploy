+import { readFileSync } from 'node:fs';
+import type { OperationContext } from '../core/ops/contract.ts';
+import { classifyDocument } from '../core/scopes/classify.ts';
+import { assertNewScopedSource, assertScopedServeReady, publishScopedDocument } from '../core/scopes/write.ts';
+
+export const SCOPE_HELP = 'Usage: gbrain scope provision | ingest --id SOURCE --file PATH\nTrusted local MVP: fixed sources; originals and unsupported facts remain in vault; repeat ingestion refused.';
+
+export async function runScope(ctx: OperationContext, args: string[]): Promise<void> {
+  if (args[0] === 'provision' && args.length === 1) {
+    const { provisionDemo } = await import('../core/scopes/identity.ts');
+    console.log(JSON.stringify(await provisionDemo(ctx.engine)));
+    return;
+  }
+  if (args.length !== 5 || args[0] !== 'ingest' || args[1] !== '--id' || args[3] !== '--file') {
+    throw new Error(SCOPE_HELP);
+  }
+  assertScopedServeReady();
+  assertNewScopedSource(args[2]);
+  const text = readFileSync(args[4], 'utf8');
+  const facts = await classifyDocument({ text, sourceId: args[2] });
+  console.log(JSON.stringify(await publishScopedDocument(ctx, args[2], text, facts)));
+}
