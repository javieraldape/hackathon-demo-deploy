+++ b/test/scopes-write.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { assertNewScopedSource, assertScopedServeReady, planScopedPages, sourceKey } from '../src/core/scopes/write.ts';
+import type { ClassifiedFact } from '../src/core/scopes/classify.ts';
+import { withEnv } from './helpers/with-env.ts';
+
+const fact = (text: string, disposition: ClassifiedFact['disposition'], scopes: ClassifiedFact['scopes'] = []): ClassifiedFact =>
+  ({ text, evidence: text, disposition, scopes, reason: 'Synthetic test' });
+
+describe('scoped MVP placement', () => {
+  test('keeps originals private and separates supported facts', () => {
+    const pages = planScopedPages('demo-one', 'Offsite Friday. HR complaint cobalt. Juniper price 47.', [
+      fact('Offsite Friday.', 'public'), fact('HR complaint cobalt.', 'scoped', ['hr-payroll']),
+      fact('Juniper price 47.', 'scoped', ['juniper']),
+    ]);
+    expect(pages.map(page => page.sourceId)).toEqual(['mvp-vault', 'mvp-shared', 'mvp-hr-payroll', 'mvp-juniper']);
+    expect(pages[0].content).toContain('visibility: private');
+    expect(pages[1].content).not.toContain('cobalt');
+    expect(pages[1].content).not.toContain('47');
+  });
+  test('places uncertain facts only in vault', () => {
+    const pages = planScopedPages('uncertain', 'Unknown secret.', [fact('Unknown secret.', 'vault')]);
+    expect(pages.every(page => page.sourceId === 'mvp-vault')).toBe(true);
+  });
+  test('supports the explicit union rule', () => {
+    const pages = planScopedPages('union', 'Joint confidential fact.', [fact('Joint confidential fact.', 'scoped', ['hr-payroll', 'juniper'])]);
+    expect(pages.map(page => page.sourceId)).toEqual(['mvp-vault', 'mvp-hr-payroll', 'mvp-juniper']);
+  });
+  test('refuses malformed or unsupported verdicts before publication', () => {
+    expect(() => planScopedPages('bad', 'Public.', [fact('Public.', 'scoped')])).toThrow();
+    expect(() => planScopedPages('bad', 'Public.', [fact('Public.', 'public', ['juniper'])])).toThrow();
+    expect(() => planScopedPages('bad', 'Public.', [fact('Fabricated.', 'public')])).toThrow();
+    expect(() => planScopedPages('bad', 'Public.', [])).toThrow();
+    expect(() => planScopedPages('bad', 'Public.', [{ ...fact('Public.', 'public'),
+      sharedContext: { text: 'Private invented title', evidence: 'Absent title' } }])).toThrow();
+    expect(() => planScopedPages('bad', 'Private title. Public.', [{ ...fact('Private title.', 'vault'),
+      sharedContext: { text: 'Private title', evidence: 'Private title.' } }, fact('Public.', 'public')])).toThrow();
+    expect(() => planScopedPages('bad', 'Title: Safe. Public.', [{ ...fact('Public.', 'public'),
+      sharedContext: { text: 'Safe.\nSecret line', evidence: 'Title: Safe.' } }])).toThrow();
+  });
+  test('uses neutral deterministic identifiers and strips wiki links', () => {
+    const pages = planScopedPages('secret-company-name', 'See [[secret]].', [fact('See [[secret]].', 'public')]);
+    expect(pages[1].slug).not.toContain('secret');
+    expect(pages[1].content).not.toContain('[[');
+    expect(sourceKey('same')).toBe(sourceKey('same'));
+    expect(() => sourceKey('../escape')).toThrow();
+  });
+  test('blocks serving incomplete publication and refuses reserved duplicate source identities', async () => {
+    const home = mkdtempSync(join(tmpdir(), 'scoped-write-test-'));
+    try {
+      await withEnv({ GBRAIN_HOME: home }, () => {
+      mkdirSync(join(home, '.scoped', 'ingestions'), { recursive: true });
+      expect(() => assertScopedServeReady()).not.toThrow();
+      expect(() => assertNewScopedSource('sample')).not.toThrow();
+      writeFileSync(join(home, '.scoped', 'publication-blocked'), 'private manifest');
+      writeFileSync(join(home, '.scoped', 'ingestions', `${sourceKey('sample')}.json`), '{}');
+      expect(() => assertScopedServeReady()).toThrow('incomplete');
+      expect(() => assertNewScopedSource('sample')).toThrow('already ingested');
+      });
+    } finally {
+      rmSync(home, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/test/telegram-capture-persistence.serial.test.ts b/test/telegram-capture-persistence.serial.test.ts
