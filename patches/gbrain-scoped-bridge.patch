+++ b/test/scoped-mvp-eval.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, test } from 'bun:test';
+import { assessPage, assessSearch, evaluateMember, fixture, identities, validateCredentials, validateManifest, validateTools } from '../scripts/scoped-mvp-eval.ts';
+
+const envelope = (text: string) => ({ content: [{ type: 'text', text }] });
+const pages = [
+  { source_id: 'mvp-hr-payroll', slug: 'neutral-hr' },
+  { source_id: 'mvp-juniper', slug: 'neutral-deal' },
+  { source_id: 'mvp-vault', slug: 'neutral-original' },
+];
+const manifest = { pages, vaultExistenceVerifiedByOwner: true };
+
+describe('scoped MVP independent evaluator', () => {
+  test('freezes three queries, three identities, twelve facts and a vault-only case', () => {
+    expect(fixture.documents).toHaveLength(3);
+    expect(fixture.expectations.queries).toHaveLength(3);
+    expect(fixture.expectations.facts).toHaveLength(12);
+    expect(fixture.expectations.facts.some(fact => fact.readers.length === 0)).toBe(true);
+    expect(JSON.stringify(fixture.documents)).not.toContain('readers');
+    for (const fact of fixture.expectations.facts) {
+      expect(fixture.documents.find(document => document.id === fact.documentId)?.content).toContain(fact.value);
+    }
+  });
+
+  test('requires every allowed value and rejects denied values in any envelope field', () => {
+    const allowed = 'Saffron Hall cinnamon pretzels';
+    expect(assessSearch('iris', 'birchday', envelope(allowed)).pass).toBe(true);
+    expect(assessSearch('iris', 'birchday', envelope('Saffron Hall')).missing).toEqual(['b-snack']);
+    expect(assessSearch('iris', 'birchday', { ...envelope(allowed), citation: { title: 'Copper Lantern' } }).leaked).toEqual(['b-deal']);
+    expect(assessSearch('iris', 'birchday', { ...envelope(allowed), isError: true }).pass).toBe(false);
+    expect(assessSearch('elena', 'birchday', envelope(`${allowed} HRC-7421`)).pass).toBe(true);
+    expect(assessSearch('ben', 'birchday', envelope(`${allowed} Copper Lantern`)).pass).toBe(true);
+  });
+
+  test('rejects unsupported medical content for every reader and across query boundaries', () => {
+    for (const identity of identities) {
+      expect(assessSearch(identity, 'birchday', envelope('Velunex')).leaked).toEqual(['m-medical']);
+    }
+  });
+
+  test('requires real denial, never an empty success or transport failure', () => {
+    expect(assessPage('iris', pages[0], false, { isError: true, ...envelope('page_not_found') }).pass).toBe(true);
+    expect(assessPage('iris', pages[0], true, { isError: true, ...envelope(JSON.stringify({ error: 'permission_denied', message: 'Requested source is outside your granted sources' })) }).pass).toBe(true);
+    expect(assessPage('iris', pages[0], false, envelope('')).pass).toBe(false);
+    expect(assessPage('iris', pages[0], true, { isError: true, evaluatorTransportFailure: true }).pass).toBe(false);
+    expect(assessPage('iris', pages[0], true, { isError: true, ...envelope('forbidden HRC-7421') }).pass).toBe(false);
+    expect(assessPage('elena', pages[0], true, envelope('HRC-7421')).pass).toBe(true);
+    expect(assessPage('elena', pages[0], true, envelope('unrelated page')).pass).toBe(false);
+  });
+
+  test('requires restricted and vault probes with owner existence attestation', () => {
+    expect(validateManifest(manifest)).toEqual(manifest);
+    expect(validateManifest({ ...manifest, pages: pages.map(({ source_id, slug }) => ({ sourceId: source_id, slug })) }).pages.map(page => page.source_id)).toEqual(pages.map(page => page.source_id));
+    expect(() => validateManifest({ ...manifest, pages: pages.slice(0, 2) })).toThrow();
+    expect(() => validateManifest({ pages })).toThrow();
+  });
+
+  test('requires distinct client identities and refuses insecure credential destinations', () => {
+    const credentials = {
+      mcpUrl: 'http://127.0.0.1:3131/mcp', tokenUrl: 'http://127.0.0.1:3131/oauth/token',
+      identities: {
+        iris: { client_id: 'iris', client_secret: 'synthetic-iris' },
+        elena: { client_id: 'elena', client_secret: 'synthetic-elena' },
+        ben: { client_id: 'ben', client_secret: 'synthetic-ben' },
+      },
+    };
+    expect(validateCredentials(credentials)).toEqual(credentials);
+    expect(() => validateCredentials({ ...credentials, tokenUrl: 'https://different.invalid/token' })).toThrow();
+    expect(() => validateCredentials({ ...credentials, mcpUrl: 'http://external.invalid/mcp', tokenUrl: 'http://external.invalid/token' })).toThrow();
+    expect(() => validateCredentials({ ...credentials, identities: { iris: credentials.identities.iris, elena: credentials.identities.iris, ben: credentials.identities.ben } })).toThrow();
+  });
+
+  test('checks advertised tool schemas instead of assuming keyword tools exist', () => {
+    expect(() => validateTools([])).toThrow();
+    expect(() => validateTools([
+      { name: 'search', inputSchema: { properties: { query: {}, limit: {}, snippet_chars: {}, source_id: {} } } },
+      { name: 'get_page', inputSchema: { properties: { slug: {}, source_id: {}, include_content: {} } } },
+    ])).not.toThrow();
+  });
+
+  test('issues the same three queries for all members plus explicit and guessed slug probes', async () => {
+    const querySets: string[][] = [];
+    for (const identity of identities) {
+      const calls: { name: string; args: Record<string, unknown> }[] = [];
+      const checks = await evaluateMember(identity, manifest, async (name, args) => {
+        calls.push({ name, args });
+        return envelope('unit test response, not real MCP evidence');
+      });
+      expect(checks).toHaveLength(9);
+      querySets.push(calls.filter(call => call.name === 'search').map(call => String(call.args.query)));
+      expect(calls.filter(call => call.name === 'get_page' && call.args.source_id === undefined)).toHaveLength(3);
+      expect(calls.filter(call => call.name === 'get_page' && call.args.source_id !== undefined)).toHaveLength(3);
+    }
+    expect(querySets[0]).toEqual(querySets[1]);
+    expect(querySets[1]).toEqual(querySets[2]);
+  });
+});
