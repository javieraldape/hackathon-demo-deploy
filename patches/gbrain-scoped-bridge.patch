+describe('OpenClaw transport adapter', () => {
+  test('sends only a dedicated capture call and requires a committed receipt', async () => {
+    const input = { text: 'The canteen opens at noon.', accountId: 'primary',
+      conversationId: '1234', senderId: '1234', messageId: '900' };
+    const methods: string[] = [];
+    let outcome: 'success' | 'failure' | 'duplicate' = 'success';
+    const server = Bun.serve({ hostname: '127.0.0.1', port: 0, async fetch(request) {
+      const path = new URL(request.url).pathname;
+      if (path === '/oauth/token') {
+        const form = new URLSearchParams(await request.text());
+        expect(form.get('grant_type')).toBe('client_credentials');
+        expect(form.get('scope')).toBe('write');
+        return Response.json({ token_type: 'Bearer', access_token: 'synthetic-test-token' });
+      }
+      expect(path).toBe('/mcp');
+      if (request.method === 'DELETE') return new Response(null, { status: 204 });
+      const accept = request.headers.get('accept') ?? '';
+      if (!accept.includes('application/json') || !accept.includes('text/event-stream')) {
+        return new Response('Client must accept both application/json and text/event-stream', { status: 406 });
+      }
+      expect(request.headers.get('authorization')).toBe('Bearer synthetic-test-token');
+      const rpc = await request.json() as { method: string; id?: number; params?: { name: string; arguments: Record<string, unknown> } };
+      methods.push(rpc.method);
+      if (rpc.method === 'notifications/initialized') return new Response(null, { status: 202 });
+      if (rpc.method === 'initialize') return new Response(`event: message\ndata: ${JSON.stringify({
+        jsonrpc: '2.0', id: rpc.id, result: { protocolVersion: '2025-03-26',
+          capabilities: { tools: {} }, serverInfo: { name: 'disposable-gbrain', version: '1.0.0' } },
+      })}\n\n`, { headers: { 'content-type': 'text/event-stream' } });
+      expect(rpc.method).toBe('tools/call');
+      expect(rpc.params?.name).toBe('capture_telegram_transcript');
+      expect(rpc.params?.arguments.message_id).toBe('900');
+      expect(rpc.params?.arguments).not.toHaveProperty('source_id');
+      const result = outcome === 'success'
+        ? { content: [{ type: 'text', text: JSON.stringify({ state: 'committed',
+          source_id: `telegram-${'a'.repeat(40)}`, facts: 2, pages: 3 }) }] }
+        : { isError: true, content: outcome === 'failure' ? [] : [{ type: 'text', text: JSON.stringify({
+          message: 'Source identity already ingested or reserved; updates are outside this MVP',
+        }) }] };
+      return new Response(`event: message\ndata: ${JSON.stringify({ jsonrpc: '2.0', id: rpc.id, result })}\n\n`,
+        { headers: { 'content-type': 'text/event-stream' } });
+    } });
+    try {
+      await withEnv({ GBRAIN_TELEGRAM_CAPTURE_MCP_URL: `http://127.0.0.1:${server.port}/mcp`,
+        GBRAIN_TELEGRAM_CAPTURE_TOKEN_URL: `http://127.0.0.1:${server.port}/oauth/token`,
+        GBRAIN_TELEGRAM_CAPTURE_CLIENT_ID: 'synthetic-test-id',
+        GBRAIN_TELEGRAM_CAPTURE_CLIENT_SECRET: 'synthetic-test-secret' }, async () => {
+        expect(await captureTranscript(input)).toContain('2 classified facts');
+        expect(methods).toContain('initialize');
+        expect(methods).toContain('notifications/initialized');
+        expect(methods).toContain('tools/call');
+        outcome = 'failure';
+        await expect(captureTranscript(input)).rejects.toThrow('no shared-memory fallback');
+        outcome = 'duplicate';
+        await expect(captureTranscript(input)).rejects.toThrow('already captured or reserved');
+      });
+    } finally { server.stop(true); }
+  });
+
+  test('rejects unsupported/oversized documents and symlink escape', async () => {
+    const inbox = await mkdtemp(join(tmpdir(), 'capture-inbox-'));
+    const outside = await mkdtemp(join(tmpdir(), 'capture-outside-'));
+    try {
+      await withEnv({ GBRAIN_TELEGRAM_MEDIA_DIR: inbox }, async () => {
+        const file = join(inbox, 'meeting.txt');
+        await writeFile(file, 'Shared cafe visit.');
+        expect(await readTranscriptDocument({ contentType: 'text/plain', path: file })).toBe('Shared cafe visit.');
+        await expect(readTranscriptDocument({ contentType: 'application/pdf', path: file })).rejects.toThrow('.txt');
+        await writeFile(file, Buffer.from([0xff]));
+        await expect(readTranscriptDocument({ contentType: 'text/plain', path: file })).rejects.toThrow();
+        await writeFile(file, 'x'.repeat(20_001));
+        await expect(readTranscriptDocument({ contentType: 'text/plain', path: file })).rejects.toThrow('20,000');
+        const target = join(outside, 'other.txt');
+        await writeFile(target, 'Do not read.');
+        await symlink(target, join(inbox, 'link.txt'));
+        await expect(readTranscriptDocument({ contentType: 'text/plain', path: join(inbox, 'link.txt') })).rejects.toThrow('outside');
+      });
+    } finally {
+      await rm(inbox, { recursive: true, force: true });
+      await rm(outside, { recursive: true, force: true });
+    }
+  });
+
