index 00000000..a13d8c91
--- /dev/null
+++ b/src/core/ops/scoped-amend.ts
@@ -0,0 +1,92 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import type { Operation } from './contract.ts';
+import { OperationError } from './contract.ts';
+import { classifyContextLabel } from '../scopes/classify.ts';
+import { assertScopedServeReady, scopedStateDir, sourceKey } from '../scopes/write.ts';
+import { readLocalWriter, withVerifiedLocalRegistration } from '../persistence/identity.ts';
+import { submitPageMutation } from '../persistence/page-mutations.ts';
+
+export const scopedAmendOperation: Operation = {
+  name: 'amend_scoped_context',
+  description: 'Operator-only additive shared context index for a verified committed scoped ingestion.',
+  scope: 'admin', requiredScopes: ['admin'], mutating: true, area: 'ingest',
+  params: {
+    source_id: { type: 'string', required: true },
+    source_hash: { type: 'string', required: true },
+  },
+  handler: async (ctx, params) => {
+    if (ctx.remote !== true || ctx.transport !== 'http' || ctx.auth?.principal?.kind !== 'oauth_client' ||
+        !ctx.auth.scopes?.includes('admin') || ctx.auth.allowedOperations?.length !== 1 ||
+        ctx.auth.allowedOperations[0] !== 'amend_scoped_context' || ctx.auth.grantProjectionDegraded ||
+        ctx.auth.sourceId !== 'mvp-shared' || !ctx.auth.allowedSources?.includes('mvp-shared') ||
+        !ctx.auth.allowedSources.includes('mvp-vault') || (ctx.brainId && ctx.brainId !== 'host')) {
+      throw new OperationError('permission_denied', 'A dedicated operator amendment grant on the host brain is required.');
+    }
+    if (typeof params.source_id !== 'string' || typeof params.source_hash !== 'string' ||
+        !/^[a-f0-9]{64}$/.test(params.source_hash)) throw new OperationError('invalid_params', 'A source identity and SHA-256 hash are required.');
+    assertScopedServeReady();
+    const key = sourceKey(params.source_id);
+    const root = scopedStateDir();
+    const manifestPath = join(root, 'ingestions', `${key}.json`);
+    const rawManifest = readFileSync(manifestPath, 'utf8');
+    const manifest = JSON.parse(rawManifest);
+    if (manifest.sourceId !== params.source_id || manifest.sourceHash !== params.source_hash || manifest.state !== 'committed' ||
+        !Array.isArray(manifest.pages) || !Array.isArray(manifest.committed) ||
+        manifest.pages.length !== manifest.committed.length) throw new Error('Committed source manifest does not match.');
+    const slug = `scoped-mvp/context/${key}`;
+    const auditPath = join(root, 'context-amendments', `${key}.json`);
+    if (existsSync(auditPath)) {
+      const audit = JSON.parse(readFileSync(auditPath, 'utf8'));
+      const saved = await ctx.engine.getPage(slug, { sourceId: 'mvp-shared' });
+      if (audit.state === 'committed' && audit.sourceHash === params.source_hash && saved &&
+          createHash('sha256').update(saved.compiled_truth).digest('hex') === audit.savedHash) return { state: 'committed', slug, replay: true };
+      throw new Error('Amendment exists but is incomplete or changed; operator recovery required.');
+    }
+    const original = await ctx.engine.getPage(`scoped-mvp/originals/${key}`, { sourceId: 'mvp-vault' });
+    if (!original || original.source_id !== 'mvp-vault' || original.frontmatter.visibility !== 'private') throw new Error('Private original is missing.');
+    const originalText = original.compiled_truth.trim();
+    const hashMatches = [originalText, `${originalText}\n`].some(text => createHash('sha256').update(text).digest('hex') === params.source_hash);
+    if (!hashMatches) throw new Error('Original body does not match the committed source hash.');
+    const label = await classifyContextLabel(originalText);
+    if (!label) throw new Error('Context label was not explicitly approved for shared search.');
+    const refs = manifest.pages.filter((page: { sourceId: string; slug: string }) => page.sourceId === 'mvp-shared');
+    if (!refs.length || refs.length > 30) throw new Error('No bounded approved shared facts exist.');
+    const lines: string[] = [];
+    for (const ref of refs) {
+      if (typeof ref.slug !== 'string' || !ref.slug.startsWith(`scoped-mvp/${key}/`) ||
+          !manifest.committed.some((page: { sourceId: string; slug: string }) => page.sourceId === 'mvp-shared' && page.slug === ref.slug)) throw new Error('Shared fact reference is not committed.');
+      const page = await ctx.engine.getPage(ref.slug, { sourceId: 'mvp-shared' });
+      if (!page || page.source_id !== 'mvp-shared' || page.frontmatter.visibility === 'private' || !page.compiled_truth.trim()) throw new Error('Shared fact page is missing or not public.');
+      lines.push(`- ${page.compiled_truth.replace(/\s+/g, ' ').replaceAll('[[', '[').replaceAll(']]', ']').trim()} (see ${ref.slug})`);
+    }
+    const body = `Context: ${label.text.replaceAll('[[', '[').replaceAll(']]', ']')}\n\n${lines.join('\n')}`;
+    if (body.length > 30_000) throw new Error('Context index exceeds its bounded size.');
+    if (await ctx.engine.getPage(slug, { sourceId: 'mvp-shared', includeDeleted: true })) throw new Error('Index destination exists without a committed amendment.');
+    const registration = await readLocalWriter(ctx.engine, 'cli');
+    assertScopedServeReady();
+    if (readFileSync(manifestPath, 'utf8') !== rawManifest) throw new Error('Ingestion manifest changed; retry after review.');
+    mkdirSync(join(root, 'context-amendments'), { recursive: true, mode: 0o700 });
+    const audit = { state: 'publishing', sourceId: params.source_id, sourceHash: params.source_hash,
+      operator: ctx.auth.clientId, label, refs, slug, requestId: randomUUID(), savedHash: '' };
+    const marker = join(root, 'publication-blocked');
+    writeFileSync(marker, auditPath, { flag: 'wx', mode: 0o600 });
+    writeFileSync(auditPath, JSON.stringify(audit, null, 2), { flag: 'wx', mode: 0o600 });
+    const receipt = await withVerifiedLocalRegistration(ctx.engine, registration, () => submitPageMutation(
+      { ...ctx, remote: false, auth: undefined, sourceId: 'mvp-shared' }, {
+        operation: 'put_page', waitMs: 60_000, params: { source_id: 'mvp-shared', slug,
+          content: `---\ntitle: Shared context index\ntype: note\n---\n\n${body}\n`, request_id: audit.requestId,
+          source_kind: 'scoped-context-amendment', ingested_via: 'amend-scoped-context' },
+      }));
+    if (receipt.state !== 'committed') throw new Error('Amendment did not commit; reads remain blocked.');
+    const saved = await ctx.engine.getPage(slug, { sourceId: 'mvp-shared' });
+    if (!saved || saved.compiled_truth.trim() !== body.trim()) throw new Error('Amendment readback failed; reads remain blocked.');
+    audit.savedHash = createHash('sha256').update(saved.compiled_truth).digest('hex');
+    audit.state = 'committed';
+    writeFileSync(auditPath, JSON.stringify(audit, null, 2), { mode: 0o600 });
+    if (readFileSync(marker, 'utf8') !== auditPath) throw new Error('Publication marker ownership changed.');
+    unlinkSync(marker);
+    return { state: 'committed', slug, replay: false };
+  },
+};
