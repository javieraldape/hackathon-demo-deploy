diff --git a/integration/qm-identity-gate/identity-gate.ts b/integration/qm-identity-gate/identity-gate.ts
new file mode 100644
index 00000000..7dec4a13
--- /dev/null
+++ b/integration/qm-identity-gate/identity-gate.ts
@@ -0,0 +1,129 @@
+import { createServer, request as httpRequest, type IncomingMessage } from 'node:http';
+import { createHmac, scryptSync, timingSafeEqual } from 'node:crypto';
+import { readFileSync, statSync } from 'node:fs';
+
+export type GateConfig = {
+  origin: string;
+  port: number;
+  upstreamPort: number;
+  org: string;
+  sessionSecret: string;
+  users: Record<'admin' | 'intern', { principal: string; salt: string; hash: string }>;
+};
+
+export function validateConfig(config: GateConfig): GateConfig {
+  const origin = new URL(config.origin);
+  if (origin.protocol !== 'https:' || origin.origin !== config.origin || origin.username || origin.password
+    || !Number.isInteger(config.port) || config.port < 1024 || config.port > 65535
+    || !Number.isInteger(config.upstreamPort) || config.upstreamPort < 1024 || config.upstreamPort > 65535
+    || !config.org || config.sessionSecret.length < 32) throw new Error('Invalid identity gateway configuration');
+  for (const name of ['admin', 'intern'] as const) {
+    const user = config.users[name];
+    if (!user?.principal || !/^[a-f0-9]{32}$/.test(user.salt) || !/^[a-f0-9]{64}$/.test(user.hash)) {
+      throw new Error('Invalid account configuration');
+    }
+  }
+  if (config.users.admin.principal === config.users.intern.principal) throw new Error('Accounts must have distinct principals');
+  return config;
+}
+
+export function authenticate(header: string | undefined, config: GateConfig): string | null {
+  if (!header?.startsWith('Basic ') || header.length > 1024) return null;
+  const decoded = Buffer.from(header.slice(6), 'base64').toString('utf8');
+  const colon = decoded.indexOf(':');
+  if (colon < 0) return null;
+  const name = decoded.slice(0, colon);
+  if (name !== 'admin' && name !== 'intern') return null;
+  const user = config.users[name];
+  const actual = scryptSync(decoded.slice(colon + 1), user.salt, 32);
+  return timingSafeEqual(actual, Buffer.from(user.hash, 'hex')) ? user.principal : null;
+}
+
+export function portalCookie(config: GateConfig, principal: string, now = Date.now()): string {
+  const seconds = Math.floor(now / 1000);
+  const claims = { k: 'session', sub: principal, org: config.org, iat: seconds, auth: seconds, exp: seconds + 60 };
+  const key = createHmac('sha256', config.sessionSecret).update('portal.session.v1').digest();
+  const body = Buffer.from(JSON.stringify(claims)).toString('base64url');
+  const signature = createHmac('sha256', key).update(body).digest('base64url');
+  return `portal_session=${body}.${signature}`;
+}
+
+export function allowedRequest(req: Pick<IncomingMessage, 'url' | 'headers' | 'method'>, config: GateConfig): boolean {
+  if (!['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'].includes(req.method ?? '')) return false;
+  const raw = req.url ?? '/';
+  if (!raw.startsWith('/') || raw.startsWith('//') || /[\\\x00-\x20]/.test(raw)) return false;
+  let path: string;
+  try { path = decodeURIComponent(raw.split('?')[0]); } catch { return false; }
+  if (path.split('/').some(segment => segment === '.' || segment === '..')
+    || path.includes('//') || path.includes('\\') || path.includes('%')) return false;
+  if (!/^\/(?:$|me$|api(?:\/|$)|assets\/|brand-mark\.svg$|favicon\.ico$|favicon\.svg$|manifest\.webmanifest$|robots\.txt$)/.test(path)) return false;
+  if (/^\/(?:auth|admin|v1|signin|playground|apps|deployments)(?:\/|$)/i.test(path)
+    || /(?:^|\/)(?:admin|auth|share[^/]*|impersonate|fork|adopt|deployments|apps)(?:\/|$)/i.test(path)) return false;
+  if (req.headers.origin && req.headers.origin !== config.origin) return false;
+  const site = req.headers['sec-fetch-site'];
+  if ((site === 'cross-site' || site === 'same-site') && req.headers['sec-fetch-mode'] !== 'navigate') return false;
+  if (!['GET', 'HEAD', 'OPTIONS'].includes(req.method ?? '') && req.headers.origin !== config.origin) return false;
+  return true;
+}
+
+export function createGate(config: GateConfig) {
+  validateConfig(config);
+  let failedWindow = 0;
+  let failedCount = 0;
+  const server = createServer((req, res) => {
+    res.setHeader('cache-control', 'no-store');
+    res.setHeader('referrer-policy', 'no-referrer');
+    if (!allowedRequest(req, config)) { res.writeHead(403).end('Forbidden'); return; }
+    if (!req.headers.authorization) {
+      res.writeHead(401, { 'www-authenticate': 'Basic realm="Scoped QM", charset="UTF-8"' }).end('Sign in');
+      return;
+    }
+    const now = Date.now();
+    if (now - failedWindow > 60_000) { failedWindow = now; failedCount = 0; }
+    const principal = authenticate(req.headers.authorization, config);
+    if (!principal) {
+      if (failedCount >= 20) { res.writeHead(429, { 'retry-after': '60' }).end('Try later'); return; }
+      failedCount++;
+      res.writeHead(401, { 'www-authenticate': 'Basic realm="Scoped QM", charset="UTF-8"' }).end('Sign in');
+      return;
+    }
+    const headers: Record<string, string> = {
+      host: `localhost:${config.upstreamPort}`,
+      cookie: portalCookie(config, principal),
+    };
+    for (const name of ['accept', 'accept-language', 'content-type', 'content-length', 'last-event-id', 'range', 'if-range']) {
+      const value = req.headers[name];
+      if (typeof value === 'string') headers[name] = value;
+    }
+    if (req.headers.origin) headers.origin = `http://localhost:${config.upstreamPort}`;
+    const upstream = httpRequest({ hostname: '127.0.0.1', port: config.upstreamPort, path: req.url, method: req.method, headers }, response => {
+      const outgoing: Record<string, string | string[]> = {};
+      for (const name of ['content-type', 'content-length', 'content-encoding', 'content-range', 'accept-ranges', 'content-security-policy', 'x-content-type-options']) {
+        const value = response.headers[name];
+        if (value !== undefined) outgoing[name] = value;
+      }
+      const location = response.headers.location;
+      if (location && location.startsWith('/') && !location.startsWith('//')) outgoing.location = location;
+      res.writeHead(response.statusCode ?? 502, outgoing);
+      response.pipe(res);
+    });
+    upstream.on('error', () => {
+      if (!res.headersSent) res.writeHead(502).end('QM unavailable');
+      else res.destroy();
+    });
+    upstream.setTimeout(120_000, () => upstream.destroy(new Error('Upstream timeout')));
+    req.on('aborted', () => upstream.destroy());
+    res.on('close', () => upstream.destroy());
+    req.pipe(upstream);
+  });
+  server.requestTimeout = 120_000;
+  server.headersTimeout = 15_000;
+  return server;
+}
+
+if (import.meta.main) {
+  const path = process.env.SCOPED_GATE_CONFIG;
+  if (!path || (statSync(path).mode & 0o077) !== 0) throw new Error('Private gateway configuration required');
+  const config = validateConfig(JSON.parse(readFileSync(path, 'utf8')));
+  createGate(config).listen(config.port, '127.0.0.1', () => console.log('Scoped QM identity gateway listening on loopback'));
+}
diff --git a/scripts/scoped-mvp-eval.ts b/scripts/scoped-mvp-eval.ts
new file mode 100644
index 00000000..f0b59051
--- /dev/null
+++ b/scripts/scoped-mvp-eval.ts
@@ -0,0 +1,243 @@
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js';
+import { mkdir, readFile, stat, writeFile } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+import { createHash } from 'node:crypto';
+import fixtureData from '../test/scoped-mvp-fixture.json';
+
+export const identities = ['iris', 'elena', 'ben'] as const;
+export type Identity = typeof identities[number];
+export const fixture = fixtureData;
+type ToolResult = { isError?: boolean; [key: string]: unknown };
+type Page = { source_id: string; slug: string };
+type Manifest = { pages: Page[]; vaultExistenceVerifiedByOwner: boolean };
+type Credentials = {
+  mcpUrl: string;
+  tokenUrl: string;
+  identities: Record<Identity, { client_id: string; client_secret: string }>;
+};
+export type Check = {
+  id: string;
+  identity: Identity;
+  kind: 'search' | 'get_page';
+  pass: boolean;
+  missing: string[];
+  leaked: string[];
+  error?: string;
+  raw: ToolResult;
+};
+
+function normalized(value: string): string {
+  return value.normalize('NFKC').toLowerCase().replace(/\s+/g, ' ');
+}
+
+function rawText(result: ToolResult): string {
+  return normalized(JSON.stringify(result));
+}
+
+export function assessSearch(identity: Identity, queryId: string, raw: ToolResult): Check {
+  const query = fixture.expectations.queries.find(item => item.id === queryId);
+  if (!query) throw new Error('Unknown frozen query');
+  const text = rawText(raw);
+  const missing = fixture.expectations.facts.filter(fact =>
+    fact.documentId === query.documentId && fact.readers.includes(identity) && !text.includes(normalized(fact.value)),
+  ).map(fact => fact.id);
+  const leaked = fixture.expectations.facts.filter(fact =>
+    !fact.readers.includes(identity) && text.includes(normalized(fact.value)),
+  ).map(fact => fact.id);
+  return { id: queryId, identity, kind: 'search', pass: raw.isError !== true && missing.length === 0 && leaked.length === 0, missing, leaked, raw };
+}
+
+export function assessPage(identity: Identity, page: Page, explicitSource: boolean, raw: ToolResult): Check {
+  const allowed = fixture.expectations.identities[identity].includes(page.source_id);
+  const text = rawText(raw);
+  const leaked = fixture.expectations.facts.filter(fact =>
+    !fact.readers.includes(identity) && text.includes(normalized(fact.value)),
+  ).map(fact => fact.id);
+  const scopedReader = page.source_id === 'mvp-hr-payroll' ? 'elena' : page.source_id === 'mvp-juniper' ? 'ben' : null;
+  const expectedValues = fixture.expectations.facts.filter(fact =>
+    scopedReader !== null && fact.readers.length === 1 && fact.readers.includes(scopedReader),
+  );
+  const visibleExpectedValue = expectedValues.some(fact => text.includes(normalized(fact.value)));
+  const denial = raw.isError === true && /page_not_found|page not found|permission_denied|access.denied|forbidden|not (?:permitted|authorized|allowed)|source_scope_denied/.test(text);
+  const pass = leaked.length === 0 && (allowed ? raw.isError !== true && visibleExpectedValue : denial);
+  return {
+    id: `${page.source_id}:${page.slug}:${explicitSource ? 'explicit-source' : 'guessed-slug'}`,
+    identity, kind: 'get_page', pass, missing: allowed && !visibleExpectedValue ? ['authorized-restricted-value'] : [], leaked, raw,
+  };
+}
+
+export function validateManifest(value: unknown): Manifest {
+  const manifest = structuredClone(value) as Manifest;
+  if (!manifest || !Array.isArray(manifest.pages) || manifest.vaultExistenceVerifiedByOwner !== true) {
+    throw new Error('Manifest requires pages and vaultExistenceVerifiedByOwner:true from the ingestion owner');
+  }
+  for (const page of manifest.pages) {
+    page.source_id ??= (page as Page & { sourceId?: string }).sourceId!;
+    if (!page || typeof page.slug !== 'string' || !page.slug.trim() ||
+        !['mvp-hr-payroll', 'mvp-juniper', 'mvp-vault'].includes(page.source_id)) {
+      throw new Error('Manifest contains an invalid restricted page');
+    }
+  }
+  for (const source of ['mvp-hr-payroll', 'mvp-juniper', 'mvp-vault']) {
+    if (!manifest.pages.some(page => page.source_id === source)) throw new Error(`Missing manifest source: ${source}`);
+  }
+  return manifest;
+}
+
+export function validateCredentials(value: unknown): Credentials {
+  const credentials = value as Credentials;
+  if (!credentials || !credentials.identities) throw new Error('Missing member credentials');
+  const mcp = new URL(credentials.mcpUrl);
+  const token = new URL(credentials.tokenUrl);
+  if (mcp.origin !== token.origin) throw new Error('MCP and OAuth endpoints must have the same origin');
+  for (const url of [mcp, token]) {
+    if (url.username || url.password || url.search || url.hash ||
+        (url.protocol !== 'https:' && !(url.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)))) {
+      throw new Error('Credentials require HTTPS or loopback HTTP, with no URL secrets');
+    }
+  }
+  for (const identity of identities) {
+    const member = credentials.identities[identity];
+    if (!member || typeof member.client_id !== 'string' || !member.client_id ||
+        typeof member.client_secret !== 'string' || !member.client_secret) {
+      throw new Error(`Missing client credentials for ${identity}`);
+    }
+  }
+  if (new Set(identities.map(identity => credentials.identities[identity].client_id)).size !== 3) {
+    throw new Error('Each identity must have a distinct OAuth client');
+  }
+  return credentials;
+}
+
+async function connect(credentials: Credentials, identity: Identity): Promise<Client> {
+  const member = credentials.identities[identity];
+  const response = await fetch(credentials.tokenUrl, {
+    method: 'POST', redirect: 'error', signal: AbortSignal.timeout(30_000),
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({ grant_type: 'client_credentials', scope: 'read', ...member }),
+  });
+  if (!response.ok) throw new Error(`OAuth HTTP ${response.status} for ${identity}`);
+  const body = await response.json() as { access_token?: string; token_type?: string };
+  if (!body.access_token || body.token_type?.toLowerCase() !== 'bearer') throw new Error(`OAuth returned no bearer token for ${identity}`);
+  const client = new Client({ name: `scoped-mvp-eval-${identity}`, version: '1' }, { capabilities: {} });
+  try {
+    await client.connect(new StreamableHTTPClientTransport(new URL(credentials.mcpUrl), {
+      requestInit: { headers: { Authorization: `Bearer ${body.access_token}` }, redirect: 'error' },
+    }), { signal: AbortSignal.timeout(30_000) });
+    return client;
+  } catch {
+    await client.close().catch(() => {});
+    throw new Error(`MCP connection failed for ${identity}`);
+  }
+}
+
+export function validateTools(tools: Array<{ name: string; inputSchema: { properties?: Record<string, unknown> } }>): void {
+  for (const [name, fields] of [['search', ['query', 'limit', 'snippet_chars', 'source_id']], ['get_page', ['slug', 'source_id', 'include_content']]] as const) {
+    const tool = tools.find(item => item.name === name);
+    if (!tool || fields.some(field => !tool.inputSchema.properties?.[field])) {
+      throw new Error(`Advertised ${name} tool is missing or has an unsupported schema`);
+    }
+  }
+}
+
+export async function evaluateMember(identity: Identity, manifest: Manifest,
+  call: (name: string, args: Record<string, unknown>) => Promise<ToolResult>): Promise<Check[]> {
+  const checks: Check[] = [];
+  for (const query of fixture.expectations.queries) {
+    const raw = await call('search', { query: query.text, limit: 50, snippet_chars: 10000, source_id: '__all__' });
+    checks.push(assessSearch(identity, query.id, raw));
+  }
+  for (const page of manifest.pages) {
+    for (const explicitSource of [false, true]) {
+      const raw = await call('get_page', {
+        slug: page.slug, include_content: true, ...(explicitSource ? { source_id: page.source_id } : {}),
+      });
+      checks.push(assessPage(identity, page, explicitSource, raw));
+    }
+  }
+  return checks;
+}
+
+async function savePrivate(path: string, value: unknown): Promise<void> {
+  await mkdir(dirname(path), { recursive: true, mode: 0o700 });
+  await writeFile(path, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600, flag: 'wx' });
+}
+
+async function main(): Promise<void> {
+  const args = process.argv.slice(2);
+  const options = new Map<string, string>();
+  for (let i = 0; i < args.length; i += 2) {
+    if (!['--credentials', '--manifest', '--out', '--export-documents'].includes(args[i]) || !args[i + 1]) {
+      throw new Error('Usage: bun scripts/scoped-mvp-eval.ts --credentials PRIVATE_DIRECTORY --manifest PAGES_JSON --out NEW_PRIVATE_REPORT; or --export-documents NEW_JSON');
+    }
+    options.set(args[i], args[i + 1]);
+  }
+  if (options.has('--export-documents')) {
+    await savePrivate(options.get('--export-documents')!, fixture.documents);
+    console.log('Exported documents only; evaluator expectations were excluded.');
+    return;
+  }
+  const home = process.env.GBRAIN_HOME;
+  const credentialsPath = options.get('--credentials') ?? (home ? join(home, '.scoped', 'creds') : undefined);
+  const manifestPath = options.get('--manifest');
+  const outputPath = options.get('--out');
+  if (!credentialsPath || !manifestPath || !outputPath) throw new Error('Member credentials, manifest, and new private report path are required');
+  const members: Partial<Credentials['identities']> = {};
+  let mcpUrl: string | undefined;
+  for (const identity of identities) {
+    const path = join(credentialsPath, `${identity}.json`);
+    if (((await stat(path)).mode & 0o077) !== 0) throw new Error('Credential file must not be accessible to group or others');
+    const member = JSON.parse(await readFile(path, 'utf8')) as { clientId: string; clientSecret: string; url: string };
+    if (mcpUrl !== undefined && mcpUrl !== member.url) throw new Error('Members must use the same MCP endpoint');
+    mcpUrl = member.url;
+    members[identity] = { client_id: member.clientId, client_secret: member.clientSecret };
+  }
+  const credentials = validateCredentials({ mcpUrl, tokenUrl: new URL('/token', mcpUrl).href, identities: members });
+  const manifest = validateManifest(JSON.parse(await readFile(manifestPath, 'utf8')));
+  const checks: Check[] = [];
+  const failures: string[] = [];
+  const surfaces: Record<string, string[]> = {};
+  for (const identity of identities) {
+    let client: Client | undefined;
+    try {
+      client = await connect(credentials, identity);
+      const tools = [];
+      let cursor: string | undefined;
+      do {
+        const page = await client.listTools(cursor ? { cursor } : undefined);
+        tools.push(...page.tools);
+        cursor = page.nextCursor;
+      } while (cursor);
+      validateTools(tools);
+      surfaces[identity] = tools.map(tool => tool.name);
+      checks.push(...await evaluateMember(identity, manifest, async (name, args) => {
+        try {
+          return await client!.callTool({ name, arguments: args }, undefined, { timeout: 30_000 }) as ToolResult;
+        } catch {
+          return { isError: true, evaluatorTransportFailure: true };
+        }
+      }));
+    } catch {
+      failures.push(`${identity}: authentication, initialization, or advertised-tool validation failed`);
+    } finally {
+      await client?.close().catch(() => {});
+    }
+  }
+  const pass = failures.length === 0 && checks.filter(check => check.kind === 'search').length === 9 && checks.every(check => check.pass);
+  await savePrivate(outputPath, {
+    kind: 'bounded-scoped-mvp-demonstration', benchmark: false, timestamp: new Date().toISOString(),
+    fixtureSha256: createHash('sha256').update(await readFile(new URL('../test/scoped-mvp-fixture.json', import.meta.url))).digest('hex'),
+    pass, checks, failures, surfaces,
+    limitations: ['Exact synthetic value checks are not a general privacy proof.', 'Vault page existence is attested by the ingestion owner, not read with an operator credential.', 'Classifier failure and duplicate-ingestion checks must be supplied separately by the ingestion owner.'],
+  });
+  console.log(JSON.stringify({ pass, checks: checks.length, passed: checks.filter(check => check.pass).length, failedIdentities: failures.length }));
+  if (!pass) process.exitCode = 1;
+}
+
+if (import.meta.main) {
+  main().catch(() => {
+    console.error('Scoped MVP evaluation could not complete. Check private input paths, schemas, permissions, endpoint availability, and whether the output already exists.');
+    process.exitCode = 1;
+  });
+}
