diff --git a/integration/openclaw-telegram-capture/index.mjs b/integration/openclaw-telegram-capture/index.mjs
new file mode 100644
index 00000000..0aea8822
--- /dev/null
+++ b/integration/openclaw-telegram-capture/index.mjs
@@ -0,0 +1,189 @@
+import { constants } from 'node:fs';
+import { open } from 'node:fs/promises';
+import { realpath } from 'node:fs/promises';
+import { relative, sep } from 'node:path';
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js';
+
+const LIMIT = 20_000;
+const COMMAND = 'capture_meeting';
+
+export function validateTranscript(text) {
+  if (typeof text !== 'string' || !text.trim() || text.includes('\0') ||
+      text.length > LIMIT || Buffer.byteLength(text, 'utf8') > LIMIT) {
+    throw new Error('Transcript must be nonempty UTF-8 text of at most 20,000 bytes.');
+  }
+  return text;
+}
+
+export async function readTranscriptDocument(media) {
+  if (!media || media.contentType?.split(';', 1)[0]?.toLowerCase() !== 'text/plain' ||
+      typeof media.path !== 'string' || !media.path.startsWith('/')) {
+    throw new Error('Only a staged UTF-8 .txt document (text/plain) is supported.');
+  }
+  const root = process.env.GBRAIN_TELEGRAM_MEDIA_DIR;
+  if (!root || !root.startsWith('/')) throw new Error('Staged media confinement is not configured.');
+  const canonicalRoot = await realpath(root);
+  const canonicalPath = await realpath(media.path);
+  const rel = relative(canonicalRoot, canonicalPath);
+  if (!rel || rel === '..' || rel.startsWith(`..${sep}`) || rel.startsWith(sep)) {
+    throw new Error('Staged media path is outside the approved inbox.');
+  }
+  const file = await open(media.path, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const stat = await file.stat();
+    if (!stat.isFile() || stat.size > LIMIT || stat.size === 0) {
+      throw new Error('Transcript document must be a nonempty UTF-8 .txt of at most 20,000 bytes.');
+    }
+    let text;
+    try {
+      text = new TextDecoder('utf-8', { fatal: true }).decode(await file.readFile());
+    } catch {
+      throw new Error('Transcript document must be valid UTF-8 text; unsupported encodings are not accepted.');
+    }
+    return validateTranscript(text);
+  } finally {
+    await file.close();
+  }
+}
+
+export async function captureTranscript(input, transport = fetch) {
+  const text = validateTranscript(input.text);
+  const url = process.env.GBRAIN_TELEGRAM_CAPTURE_MCP_URL;
+  const tokenUrl = process.env.GBRAIN_TELEGRAM_CAPTURE_TOKEN_URL;
+  const clientId = process.env.GBRAIN_TELEGRAM_CAPTURE_CLIENT_ID;
+  const clientSecret = process.env.GBRAIN_TELEGRAM_CAPTURE_CLIENT_SECRET;
+  if (!url || !tokenUrl || !clientId || !clientSecret ||
+      !/^https:\/\//.test(url) && !/^http:\/\/(127\.0\.0\.1|localhost)(:\d+)?\//.test(url) ||
+      new URL(tokenUrl).origin !== new URL(url).origin) {
+    throw new Error('Capture endpoint or dedicated credential is not configured.');
+  }
+  for (const key of ['accountId', 'conversationId', 'senderId', 'messageId']) {
+    if (typeof input[key] !== 'string' || !input[key] || input[key].length > 256) {
+      throw new Error('Telegram message identity is incomplete.');
+    }
+  }
+  if (!/^\d+$/.test(input.conversationId) || !/^\d+$/.test(input.senderId) ||
+      !/^\d+$/.test(input.messageId) || input.conversationId !== input.senderId) {
+    throw new Error('Telegram message identity is incomplete.');
+  }
+  const tokenResponse = await transport(tokenUrl, {
+    method: 'POST',
+    headers: { 'content-type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({ grant_type: 'client_credentials', client_id: clientId,
+      client_secret: clientSecret, scope: 'write' }).toString(),
+    redirect: 'error',
+    signal: AbortSignal.timeout(10_000),
+  });
+  if (!tokenResponse.ok) throw new Error(`Dedicated capture authentication failed (${tokenResponse.status}).`);
+  const tokenBody = await tokenResponse.json();
+  if (tokenBody?.token_type?.toLowerCase() !== 'bearer' ||
+      typeof tokenBody.access_token !== 'string' || !tokenBody.access_token) {
+    throw new Error('Dedicated capture authentication returned an invalid token.');
+  }
+  const client = new Client({ name: 'gbrain-telegram-capture', version: '1.0.0' }, { capabilities: {} });
+  const mcp = new StreamableHTTPClientTransport(new URL(url), {
+    requestInit: { headers: { Authorization: `Bearer ${tokenBody.access_token}` }, redirect: 'error' },
+    fetch: transport,
+  });
+  let body;
+  try {
+    await client.connect(mcp);
+    body = await client.callTool({
+      name: 'capture_telegram_transcript', arguments: {
+        text,
+        account_id: input.accountId,
+        conversation_id: input.conversationId,
+        sender_id: input.senderId,
+        message_id: input.messageId,
+      },
+    }, undefined, { timeout: 300_000 });
+  } finally {
+    await client.close();
+  }
+  if (body?.isError && body.content?.some(item => {
+    if (item.type !== 'text') return false;
+    try { return /Source identity already ingested or reserved/.test(JSON.parse(item.text).message); }
+    catch { return false; }
+  })) throw new Error('Transcript already captured or reserved; no second publication was attempted.');
+  if (body?.isError || !Array.isArray(body?.content)) {
+    throw new Error('GBrain capture failed; no shared-memory fallback was attempted.');
+  }
+  const result = JSON.parse(body.content.find(item => item.type === 'text')?.text ?? 'null');
+  if (result?.state !== 'committed' || !/^telegram-[a-f0-9]{40}$/.test(result.source_id) ||
+      !Number.isInteger(result.facts) || !Number.isInteger(result.pages)) {
+    throw new Error('GBrain did not return a verified scoped-publication receipt.');
+  }
+  return `Captured ${result.facts} classified facts into ${result.pages} scoped pages (source ${result.source_id}).`;
+}
+
+function failure(error) {
+  if (error instanceof Error && /^(Transcript|Only a staged|Telegram message identity)/.test(error.message)) return error.message;
+  return 'Capture failed. No shared-memory fallback was attempted; an operator must inspect scoped publication before retrying.';
+}
+
+const plugin = {
+  id: 'gbrain-telegram-capture',
+  name: 'GBrain Telegram capture',
+  register(api) {
+    api.registerCommand({
+      name: COMMAND, channels: ['telegram'], acceptsArgs: true, requireAuth: true,
+      requiredScopes: ['operator.admin'], exposeSenderIsOwner: true,
+      description: 'Arm a private text/.txt transcript handoff, or close capture.',
+      async handler(ctx) {
+        if (ctx.channel !== 'telegram' || !ctx.isAuthorizedSender || ctx.senderIsOwner !== true ||
+            !/^\d+$/.test(ctx.senderId ?? '') || !ctx.from || !ctx.accountId || ctx.from !== `telegram:${ctx.senderId}`) {
+          return { text: 'Capture requires an authenticated owner in a private Telegram chat.' };
+        }
+        const args = ctx.args?.trim() ?? '';
+        if (args === 'done') {
+          try {
+            await ctx.detachConversationBinding();
+          } catch {}
+          try {
+            const binding = await ctx.getCurrentConversationBinding();
+            return { text: binding
+              ? 'Capture remains bound. Ask an operator to detach it before ordinary chat.'
+              : 'Document capture closed.' };
+          } catch {
+            return { text: 'Capture binding status could not be verified. Ask an operator to inspect it before ordinary chat.' };
+          }
+        }
+        if (args === 'arm') {
+          try {
+            const result = await ctx.requestConversationBinding({
+              summary: 'Private transcript handoff', detachHint: '/capture_meeting done',
+            });
+            if (result.status === 'pending') return result.reply;
+            if (result.status === 'bound') return { text: 'Capture bound. Send one pasted transcript or UTF-8 .txt; use /capture_meeting done to return to ordinary chat.' };
+            return { text: 'Private capture binding was refused. Do not send the transcript.' };
+          } catch { return { text: 'Private capture binding failed; do not send the transcript until it is active.' }; }
+        }
+        return { text: 'Use /capture_meeting arm, then send the transcript in the bound private chat. Inline command arguments cannot supply transport message identity.' };
+      },
+    });
+    api.on('inbound_claim', async (event, ctx) => {
+      if (ctx.channelId !== 'telegram' || !ctx.pluginBinding || !ctx.accountId || !ctx.conversationId ||
+          event.isGroup || !event.commandAuthorized || !event.senderIsOwner ||
+          !/^\d+$/.test(event.senderId ?? '') || !event.messageId ||
+          event.providerUpdate?.editedTimestamp || /edit/i.test(event.providerUpdate?.kind ?? '') ||
+          ctx.conversationId !== event.senderId) {
+        return { handled: true, reply: { text: 'Document capture denied: Telegram owner or transport identity is missing.' } };
+      }
+      if (event.mediaStagingPending || (event.media?.length ?? 0) > 1) {
+        return { handled: true, reply: { text: 'Send one pasted transcript or exactly one staged UTF-8 .txt document. Other messages are not saved.' } };
+      }
+      try {
+        const text = event.media?.length === 1
+          ? await readTranscriptDocument(event.media[0]) : validateTranscript(event.content);
+        const receipt = await captureTranscript({ text, accountId: ctx.accountId,
+          conversationId: ctx.conversationId, senderId: event.senderId, messageId: event.messageId });
+        return { handled: true, reply: { text: `${receipt} Use /capture_meeting done to return to ordinary chat.` } };
+      } catch (error) {
+        return { handled: true, reply: { text: failure(error) } };
+      }
+    });
+  },
+};
+
+export default plugin;
