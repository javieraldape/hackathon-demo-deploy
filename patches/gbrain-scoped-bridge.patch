@@ -0,0 +1,99 @@
+import { afterAll, beforeAll, expect, test } from 'bun:test';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { PGLiteEngine } from '../src/core/pglite-engine.ts';
+import { telegramCaptureOperation, telegramSourceId } from '../src/core/ops/telegram-capture.ts';
+import { sourceKey } from '../src/core/scopes/write.ts';
+import { registerLocalWriter } from '../src/core/persistence/identity.ts';
+import { addSource } from '../src/core/sources-ops.ts';
+import { disposePersistenceConsumer } from '../src/core/persistence/service.ts';
+import type { OperationContext } from '../src/core/ops/contract.ts';
+
+const document = 'The shared lunch is on Friday. HR complaint cobalt. Juniper terms are private.';
+const entries = ['The shared lunch is on Friday.', 'HR complaint cobalt.', 'Juniper terms are private.'];
+const labels = ['public', 'hr-payroll', 'juniper'];
+const choices = ['public', 'hr-payroll', 'juniper', 'hr-payroll+juniper', 'vault'];
+let engine: PGLiteEngine;
+let home: string;
+let previousHome: string | undefined;
+let oldFetch: typeof fetch;
+let oldAnthropic: string | undefined;
+let oldTypesafe: string | undefined;
+
+beforeAll(async () => {
+  home = await mkdtemp(join(tmpdir(), 'telegram-managed-capture-'));
+  previousHome = process.env.GBRAIN_HOME;
+  oldAnthropic = process.env.ANTHROPIC_API_KEY;
+  oldTypesafe = process.env.TYPESAFE_API_KEY;
+  oldFetch = globalThis.fetch;
+  process.env.GBRAIN_HOME = home;
+  process.env.ANTHROPIC_API_KEY = 'synthetic-test-key';
+  process.env.TYPESAFE_API_KEY = 'synthetic-test-key';
+  engine = new PGLiteEngine();
+  await engine.connect({});
+  await engine.initSchema();
+  await engine.setConfig('embedding_enabled', 'false');
+  await engine.setConfig('sync.write_through', 'false');
+  await engine.executeRaw('UPDATE persistence_brain SET enabled=true WHERE singleton=1');
+  await registerLocalWriter(engine, 'cli');
+  for (const id of ['mvp-shared', 'mvp-hr-payroll', 'mvp-juniper', 'mvp-vault']) {
+    await addSource(engine, { id, name: id, force: true });
+  }
+  globalThis.fetch = Object.assign(async (url: string | URL | Request) => {
+    if (String(url).includes('anthropic.com')) return Response.json({
+      stop_reason: 'tool_use', content: [{ type: 'tool_use', name: 'extract_facts', input: {
+        truncated: false, facts: entries.map(text => ({ text, evidence: text })),
+      } }],
+    });
+    return Response.json({ model: 'jev-latest', answers: Object.fromEntries(labels.map((label, index) => [
+      `fact_${index}`, { type: 'choice', choice: label, confidence: 0.96,
+        probabilities: Object.fromEntries(choices.map(choice => [choice, choice === label ? 0.96 : 0.01])) },
+    ])) });
+  }, { preconnect: oldFetch.preconnect });
+}, 90_000);
+
+afterAll(async () => {
+  globalThis.fetch = oldFetch;
+  for (const [key, value] of [
+    ['GBRAIN_HOME', previousHome], ['ANTHROPIC_API_KEY', oldAnthropic], ['TYPESAFE_API_KEY', oldTypesafe],
+  ] as const) {
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  }
+  if (engine) { await disposePersistenceConsumer(engine); await engine.disconnect(); }
+  if (home) await rm(home, { recursive: true, force: true });
+});
+
+test('dedicated remote caller publishes through verified host writer on one live PGLite engine', async () => {
+  const args = { text: document, account_id: 'primary', conversation_id: '1234', sender_id: '1234', message_id: '900' };
+  const context = { engine, config: { engine: 'pglite' }, remote: true, transport: 'http',
+    sourceId: 'mvp-vault', dryRun: false, logger: { info() {}, warn() {}, error() {} },
+    auth: { principal: { kind: 'oauth_client', id: 'synthetic-capture-client' },
+      clientId: 'synthetic-capture-client', token: 'synthetic-token', scopes: ['write'],
+      allowedOperations: ['capture_telegram_transcript'], sourceId: 'mvp-vault' } } as OperationContext;
+  const receipt = await telegramCaptureOperation.handler(context, args) as {
+    state: string; source_id: string; facts: number; pages: number;
+  };
+  expect(receipt.state).toBe('committed');
+  expect(receipt.facts).toBe(3);
+  expect(receipt.pages).toBe(4);
+  const sourceId = telegramSourceId({ accountId: 'primary', conversationId: '1234', senderId: '1234', messageId: '900' });
+  expect(receipt.source_id).toBe(sourceId);
+  const hash = sourceKey(sourceId);
+  const original = await engine.getPage(`scoped-mvp/originals/${hash}`, { sourceId: 'mvp-vault' });
+  expect(original?.compiled_truth).toContain(document);
+  const shared = await engine.executeRaw<{ compiled_truth: string }>('SELECT compiled_truth FROM pages WHERE source_id=$1', ['mvp-shared']);
+  expect(shared).toHaveLength(1);
+  expect(shared[0]?.compiled_truth).toContain(entries[0]);
+  expect(shared[0]?.compiled_truth).not.toContain('cobalt');
+  expect(shared[0]?.compiled_truth).not.toContain('Juniper');
+  const hr = await engine.executeRaw<{ compiled_truth: string }>('SELECT compiled_truth FROM pages WHERE source_id=$1', ['mvp-hr-payroll']);
+  const juniper = await engine.executeRaw<{ compiled_truth: string }>('SELECT compiled_truth FROM pages WHERE source_id=$1', ['mvp-juniper']);
+  expect(hr[0]?.compiled_truth).toContain('cobalt');
+  expect(juniper[0]?.compiled_truth).toContain('Juniper');
+  const manifest = JSON.parse(await readFile(join(home, '.scoped', 'ingestions', `${hash}.json`), 'utf8'));
+  expect(manifest.state).toBe('committed');
+  await expect(telegramCaptureOperation.handler(context, { ...args, text: 'Edited transcript.' }))
+    .rejects.toThrow('already ingested or reserved');
+}, 120_000);
diff --git a/test/telegram-capture.test.ts b/test/telegram-capture.test.ts
