+    expect(await selected(personal(principal.admin))).toEqual(['mvp-shared']);
+    await engine.setConfig('scoped.qm_bridge', JSON.stringify({ clientId, verifiedPersonalScopeFormat: 'personal:<principal>', principals: principal }));
+    await expect(operationsByName.qm_recall.handler(ctx(), { query: '', ...personal(principal.admin) })).rejects.toThrow(/nonempty query/);
+  });
+
+  test('approved shared title retrieves three public facts without private transcript markers', async () => {
+    const titleLine = 'Fictional meeting transcript: Lantern Forge coordination meeting';
+    const document = `${titleLine}\nWorkshop MAPLE-KITE-47 is public.\nLunch LEMON-PIER-62 is public.\nHandbook CEDAR-BELL-85 is public.\nHR case GARNET-LOOM-31 is private.\nJuniper OBSIDIAN-FERN-73 is private.\nMedical AMBER-HERON-28 is private.`;
+    const publicFacts = ['Workshop MAPLE-KITE-47 is public.', 'Lunch LEMON-PIER-62 is public.', 'Handbook CEDAR-BELL-85 is public.'];
+    const pages: ScopedPage[] = planScopedPages('approved-title-demo', document, publicFacts.map(text => ({
+      text, evidence: text, disposition: 'public', scopes: [], reason: 'Explicitly shared-approved context',
+      sharedContext: { text: 'Lantern Forge coordination meeting', evidence: titleLine },
+    })));
+    for (const page of pages.filter(page => page.sourceId === 'mvp-shared')) {
+      await engine.putPage(page.slug, { type: 'note', title: 'Scoped note', compiled_truth: page.content, frontmatter: {} }, { sourceId: page.sourceId });
+      await installFixtureChunks(engine, page.slug, [
+        { chunk_index: 0, chunk_source: 'compiled_truth', chunk_text: page.content },
+      ], { sourceId: page.sourceId });
+    }
+    const intern = await operationsByName.qm_recall.handler(ctx(), { query: 'Lantern Forge', ...personal(principal.intern) }) as string;
+    for (const marker of ['MAPLE-KITE-47', 'LEMON-PIER-62', 'CEDAR-BELL-85']) expect(intern).toContain(marker);
+    for (const marker of ['GARNET-LOOM-31', 'OBSIDIAN-FERN-73', 'AMBER-HERON-28']) expect(intern).not.toContain(marker);
+  });
+});
diff --git a/test/scoped-amend.serial.test.ts b/test/scoped-amend.serial.test.ts
new file mode 100644
index 00000000..a8f0c343
--- /dev/null
+++ b/test/scoped-amend.serial.test.ts
@@ -0,0 +1,94 @@
+import { expect, test } from 'bun:test';
+import { createHash } from 'node:crypto';
+import { existsSync, readFileSync } from 'node:fs';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { PGLiteEngine } from '../src/core/pglite-engine.ts';
+import { scopedAmendOperation } from '../src/core/ops/scoped-amend.ts';
+import { publishScopedDocument, sourceKey } from '../src/core/scopes/write.ts';
+import { registerLocalWriter } from '../src/core/persistence/identity.ts';
+import { addSource } from '../src/core/sources-ops.ts';
+import { disposePersistenceConsumer } from '../src/core/persistence/service.ts';
+import type { OperationContext } from '../src/core/ops/contract.ts';
+import { withEnv } from './helpers/with-env.ts';
+
+test('resident amendment is additive, idempotent, isolated-label classified, and fail-closed', async () => {
+  const home = await mkdtemp(join(tmpdir(), 'scoped-amend-'));
+  const engine = new PGLiteEngine();
+  const oldFetch = globalThis.fetch;
+  try {
+    await withEnv({ GBRAIN_HOME: home, TYPESAFE_API_KEY: 'synthetic-test-key' }, async () => {
+      await engine.connect({}); await engine.initSchema();
+      await engine.setConfig('embedding_enabled', 'false');
+      await engine.setConfig('sync.write_through', 'false');
+      await engine.executeRaw('UPDATE persistence_brain SET enabled=true WHERE singleton=1');
+      await registerLocalWriter(engine, 'cli');
+      for (const id of ['mvp-shared', 'mvp-vault']) await addSource(engine, { id, name: id, force: true });
+      const base = { engine, config: { engine: 'pglite' }, sourceId: 'mvp-shared', logger: { info() {}, warn() {}, error() {} }, dryRun: false, remote: false } as OperationContext;
+      const admin = { ...base, remote: true, transport: 'http', sourceId: 'mvp-shared', auth: {
+        principal: { kind: 'oauth_client', id: 'test-operator' }, clientId: 'test-operator', token: 'synthetic-token',
+        scopes: ['admin'], allowedOperations: ['amend_scoped_context'], sourceId: 'mvp-shared', allowedSources: ['mvp-shared', 'mvp-vault'],
+      } } as OperationContext;
+      let verdict = 'public';
+      let classifications = 0;
+      globalThis.fetch = Object.assign(async (_url: unknown, init?: RequestInit) => {
+        classifications++;
+        const request = JSON.parse(String(init?.body));
+        expect(Object.keys(request.state)).toEqual(['context_label']);
+        expect(JSON.stringify(request)).not.toContain('PRIVATE-CANARY');
+        expect(existsSync(join(home, '.scoped/publication-blocked'))).toBe(false);
+        if (verdict === 'failure') return new Response('', { status: 503 });
+        return Response.json({ model: 'jev-latest', answers: { context_label: {
+          type: 'choice', choice: verdict, confidence: 0.96,
+          probabilities: Object.fromEntries(['public', 'hr-payroll', 'juniper', 'hr-payroll+juniper', 'vault']
+            .map(choice => [choice, choice === verdict ? 0.96 : 0.01])),
+        } } });
+      }, { preconnect: oldFetch.preconnect });
+      const document = 'Meeting: Lantern Forge\nPublic workshop MAPLE-KITE-47.\nPRIVATE-CANARY medical detail.';
+      const hash = createHash('sha256').update(document).digest('hex');
+      for (const source of ['success', 'private-label', 'provider-failure', 'partial']) {
+        await publishScopedDocument(base, source, document, [
+          { text: 'Public workshop MAPLE-KITE-47.', evidence: 'Public workshop MAPLE-KITE-47.', disposition: 'public', scopes: [], reason: 'test' },
+          { text: 'PRIVATE-CANARY medical detail.', evidence: 'PRIVATE-CANARY medical detail.', disposition: 'vault', scopes: [], reason: 'test' },
+        ]);
+      }
+      const args = { source_id: 'success', source_hash: hash };
+      const before = await engine.getPage(`scoped-mvp/originals/${sourceKey('success')}`, { sourceId: 'mvp-vault' });
+      await expect(scopedAmendOperation.handler({ ...admin, auth: { ...admin.auth!, scopes: ['read'] } }, args)).rejects.toThrow('dedicated operator');
+      await expect(scopedAmendOperation.handler(admin, { ...args, source_hash: '0'.repeat(64) })).rejects.toThrow('manifest');
+      expect(classifications).toBe(0);
+      const result = await scopedAmendOperation.handler(admin, args) as { state: string; slug: string; replay: boolean };
+      expect(result.state).toBe('committed');
+      const index = await engine.getPage(result.slug, { sourceId: 'mvp-shared' });
+      expect(index?.compiled_truth).toContain('Lantern Forge');
+      expect(index?.compiled_truth).toContain('MAPLE-KITE-47');
+      expect(index?.compiled_truth).not.toContain('PRIVATE-CANARY');
+      expect(await engine.getPage(`scoped-mvp/originals/${sourceKey('success')}`, { sourceId: 'mvp-vault' })).toEqual(before);
+      expect((await engine.searchKeyword('Lantern Forge', { sourceId: 'mvp-shared', excludePrivate: true, requireSafeChunks: true })).map(page => page.slug)).toContain(result.slug);
+      const count = classifications;
+      expect(await scopedAmendOperation.handler(admin, args)).toEqual({ ...result, replay: true });
+      expect(classifications).toBe(count);
+      verdict = 'vault';
+      await expect(scopedAmendOperation.handler(admin, { ...args, source_id: 'private-label' })).rejects.toThrow('not explicitly approved');
+      expect(existsSync(join(home, '.scoped/publication-blocked'))).toBe(false);
+      verdict = 'failure';
+      await expect(scopedAmendOperation.handler(admin, { ...args, source_id: 'provider-failure' })).rejects.toThrow('classification failed');
+      expect(existsSync(join(home, '.scoped/context-amendments', `${sourceKey('provider-failure')}.json`))).toBe(false);
+      verdict = 'public';
+      const originalGet = engine.getPage.bind(engine);
+      engine.getPage = async (slug, opts) => {
+        if (slug === `scoped-mvp/context/${sourceKey('partial')}` && existsSync(join(home, '.scoped/publication-blocked'))) throw new Error('Synthetic readback failure');
+        return originalGet(slug, opts);
+      };
+      await expect(scopedAmendOperation.handler(admin, { ...args, source_id: 'partial' })).rejects.toThrow('Publication failed');
+      expect(existsSync(join(home, '.scoped/publication-blocked'))).toBe(true);
+      expect(JSON.parse(readFileSync(join(home, '.scoped/context-amendments', `${sourceKey('partial')}.json`), 'utf8')).state).toBe('publishing');
+      engine.getPage = originalGet;
+    });
+  } finally {
+    globalThis.fetch = oldFetch;
+    await disposePersistenceConsumer(engine); await engine.disconnect();
+    await rm(home, { recursive: true, force: true });
+  }
+}, 120_000);
