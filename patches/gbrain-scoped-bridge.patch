@@ -0,0 +1,220 @@
+import { describe, expect, test } from 'bun:test';
+import { telegramCaptureOperation, telegramSourceId } from '../src/core/ops/telegram-capture.ts';
+import type { OperationContext } from '../src/core/ops/contract.ts';
+import plugin, { captureTranscript, readTranscriptDocument } from '../integration/openclaw-telegram-capture/index.mjs';
+import { mkdtemp, writeFile, symlink, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { withEnv } from './helpers/with-env.ts';
+
+async function withFetch<T>(replacement: typeof fetch, fn: () => Promise<T>): Promise<T> {
+  const original = globalThis.fetch;
+  try {
+    globalThis.fetch = replacement;
+    return await fn();
+  } finally {
+    globalThis.fetch = original;
+  }
+}
+
+const principal = { kind: 'oauth_client' as const, id: 'operator-created-capture-client' };
+const ctx = (patch: Record<string, unknown> = {}) => ({
+  remote: true, transport: 'http', brainId: 'host', auth: {
+    principal, sourceId: 'mvp-vault', scopes: ['write'], allowedOperations: ['capture_telegram_transcript'],
+  }, ...patch,
+}) as unknown as OperationContext;
+const params = { text: 'A shared lunch will be on Friday.', account_id: 'primary',
+  conversation_id: '1234', sender_id: '1234', message_id: '900' };
+
+describe('Telegram capture operation', () => {
+  test('source identity is stable across retry but varies by transport message identity', () => {
+    const fields = { accountId: 'primary', conversationId: '1234', senderId: '1234', messageId: '900' };
+    expect(telegramSourceId(fields)).toBe(telegramSourceId(fields));
+    expect(telegramSourceId({ ...fields, messageId: '901' })).not.toBe(telegramSourceId(fields));
+    expect(() => telegramSourceId({ ...fields, senderId: '' })).toThrow();
+  });
+
+  test('requires the exact capture-only grant and never accepts generic agent or CLI authority', async () => {
+    for (const denied of [
+      { remote: false }, { transport: 'stdio' }, { brainId: 'another' },
+      { auth: { principal, sourceId: 'mvp-vault', allowedOperations: null } },
+      { auth: { principal, sourceId: 'mvp-vault', allowedOperations: ['capture_telegram_transcript', 'remember'] } },
+      { auth: { principal, sourceId: 'default', allowedOperations: ['capture_telegram_transcript'] } },
+    ]) {
+      await expect(telegramCaptureOperation.handler(ctx(denied), params)).rejects.toThrow('dedicated Telegram capture');
+    }
+  });
+
+  test('oversized input and incomplete provenance fail before classifier or any persistence', async () => {
+    await expect(telegramCaptureOperation.handler(ctx(), { ...params, text: 'x'.repeat(20_001) })).rejects.toThrow('20,000');
+    await expect(telegramCaptureOperation.handler(ctx(), { ...params, sender_id: '' })).rejects.toThrow('identity');
+    await expect(telegramCaptureOperation.handler(ctx(), { ...params, message_id: 'synthetic' })).rejects.toThrow('identity');
+  });
+
+  test('repeat transport message refuses before provider invocation or a second write', async () => {
+    const home = await mkdtemp(join(tmpdir(), 'capture-duplicate-'));
+    try {
+      await withEnv({ GBRAIN_HOME: home }, async () => {
+        const { mkdir } = await import('node:fs/promises');
+        const { sourceKey } = await import('../src/core/scopes/write.ts');
