diff --git a/test/scopes-classify.test.ts b/test/scopes-classify.test.ts
new file mode 100644
index 00000000..56884845
--- /dev/null
+++ b/test/scopes-classify.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, test as bunTest } from 'bun:test';
+import { classifyDocument, type ClassifiedFact } from '../src/core/scopes/classify.ts';
+import { planScopedPages } from '../src/core/scopes/write.ts';
+import { withEnv } from './helpers/with-env.ts';
+
+type Transport = NonNullable<Parameters<typeof classifyDocument>[1]>;
+
+const input = { text: 'The office opens at nine. An employee filed an HR complaint. The Juniper deal terms are confidential.', sourceId: 'fictional-doc-1' };
+const evidence = [
+  'The office opens at nine.',
+  'An employee filed an HR complaint.',
+  'The Juniper deal terms are confidential.',
+];
+const choices = ['public', 'hr-payroll', 'juniper', 'hr-payroll+juniper', 'vault'];
+
+function test(name: string, body: () => Promise<void>) {
+  bunTest(name, () => withEnv({
+    ANTHROPIC_API_KEY: 'synthetic-anthropic-key',
+    TYPESAFE_API_KEY: 'synthetic-typesafe-key',
+  }, body));
+}
+
+function extraction(facts = evidence.map(text => ({ text, evidence: text })), truncated = false) {
+  return { stop_reason: 'tool_use', content: [{ type: 'tool_use', name: 'extract_facts', input: { facts, truncated } }] };
+}
+
+function answer(choice: string, confidence = 0.95) {
+  return {
+    type: 'choice', choice, confidence,
+    probabilities: Object.fromEntries(choices.map(label => [label, label === choice ? 0.96 : 0.01])),
+  };
+}
+
+function jev(labels = ['public', 'hr-payroll', 'juniper'], context?: ReturnType<typeof answer>) {
+  const answers: Record<string, ReturnType<typeof answer>> = Object.fromEntries(
+    labels.map((label, index) => [`fact_${index}`, answer(label)]));
+  if (context) answers.context_label = context;
+  return { model: 'jev-latest', answers };
+}
+
+function mock(haiku: unknown = extraction(), typesafe: unknown = jev(), expectedText = input.text): Transport {
+  return (async (url: string | URL | Request, options?: RequestInit) => {
+    const request = JSON.parse(String(options?.body));
+    if (String(url).includes('anthropic.com')) {
+      expect(request.model).toBe('claude-haiku-4-5-20251001');
+      expect(request.messages[0].content).toBe(expectedText);
+      return Response.json(haiku);
+    }
+    expect(String(url)).toBe('https://api.typesafe.ai/v1/systemone');
+    expect(request.model).toBe('jev-latest');
+    const response = typesafe as { model: string; answers: Record<string, unknown> };
+    if (request.questions.context_label) {
+      expect(Object.keys(request.state)).toEqual(['context_label']);
+      return Response.json({ model: response.model, answers: response.answers.context_label ? { context_label: response.answers.context_label } : {} });
+    }
+    expect(request.questions.fact_0.type).toBe('choice');
+    return Response.json({ ...response, answers: Object.fromEntries(Object.entries(response.answers).filter(([key]) => key !== 'context_label')) });
+  });
+}
+
+describe('scoped document classification', () => {
+  test('extracts verbatim evidence and applies Jev public and named-scope verdicts', async () => {
+    const result: ClassifiedFact[] = await classifyDocument(input, mock());
+    expect(result.map(({ disposition, scopes }) => ({ disposition, scopes }))).toEqual([
+      { disposition: 'public', scopes: [] },
+      { disposition: 'scoped', scopes: ['hr-payroll'] },
+      { disposition: 'scoped', scopes: ['juniper'] },
+    ]);
+    expect(result.map(fact => fact.evidence)).toEqual(evidence);
+    expect(result.every(fact => fact.reason.length > 0)).toBe(true);
+  });
+
+  test('retains the union of both restricted labels', async () => {
+    const result = await classifyDocument(input, mock(extraction(), jev(['hr-payroll+juniper', 'vault', 'vault'])));
+    expect(result[0].scopes).toEqual(['hr-payroll', 'juniper']);
+    expect(result[0].disposition).toBe('scoped');
+  });
+
+  test('vaults unsupported sensitive cases and uncertain verdicts', async () => {
+    const verdict = jev(['vault', 'public', 'hr-payroll']);
+    verdict.answers.fact_1 = answer('public', 0.6);
+    const result = await classifyDocument(input, mock(extraction(), verdict));
+    expect(result.map(fact => fact.disposition)).toEqual(['vault', 'vault', 'scoped']);
+    expect(result[1].scopes).toEqual([]);
+  });
+
+  test('rejects invented evidence and truncated extraction before classifying', async () => {
+    await expect(classifyDocument(input, mock(extraction([{ text: 'Invented', evidence: 'No such phrase' }])))).rejects.toThrow('evidence');
+    await expect(classifyDocument(input, mock(extraction(undefined, true)))).rejects.toThrow('Incomplete');
+  });
+
+  test('rejects incomplete, malformed or non-choice Jev answers instead of defaulting to public', async () => {
+    await expect(classifyDocument(input, mock(extraction(), jev(['public'])))).rejects.toThrow('Incomplete');
+    const malformed = jev();
+    malformed.answers.fact_0 = { ...answer('public'), probabilities: { public: 1 } };
+    await expect(classifyDocument(input, mock(extraction(), malformed))).rejects.toThrow('Malformed');
+    malformed.answers.fact_0 = { ...answer('public'), type: 'noul' };
+    await expect(classifyDocument(input, mock(extraction(), malformed))).rejects.toThrow('Malformed');
+    malformed.answers.fact_0 = { ...answer('public'), probabilities: Object.fromEntries(choices.map(choice => [choice, 0.9])) };
+    await expect(classifyDocument(input, mock(extraction(), malformed))).rejects.toThrow('probabilities');
+  });
+
+  test('propagates provider failure and timeout without returning any facts', async () => {
+    await expect(classifyDocument(input, async () => new Response('', { status: 503 }))).rejects.toThrow('Fact extraction failed');
+    const failedJev = (async (url: string | URL | Request) => String(url).includes('anthropic.com')
+      ? Response.json(extraction()) : new Response('', { status: 504 }));
+    await expect(classifyDocument(input, failedJev)).rejects.toThrow('Fact classification failed');
+    await expect(classifyDocument(input, async () => { throw new DOMException('timeout', 'TimeoutError'); })).rejects.toThrow('timeout');
+  });
+
+  test('bounds document length and refuses empty input', async () => {
+    await expect(classifyDocument({ ...input, text: 'x'.repeat(20_001) }, mock())).rejects.toThrow('oversized');
+    await expect(classifyDocument({ ...input, text: ' ' }, mock())).rejects.toThrow('Invalid');
+  });
+
+  test('independently approves a verbatim public meeting title before attaching it only to shared facts', async () => {
+    const titleLine = 'Fictional meeting transcript: Lantern Forge coordination meeting';
+    const document = `${titleLine}\nWorkshop MAPLE-KITE-47 is for everyone.\nLunch LEMON-PIER-62 is public.\nHandbook CEDAR-BELL-85 is public.\nHR complaint GARNET-LOOM-31 is confidential.\nMedical AMBER-HERON-28 is private.`;
+    const lines = document.split('\n').slice(1);
+    const label = { text: 'Lantern Forge coordination meeting', evidence: titleLine };
+    const observed: Array<Record<string, unknown>> = [];
+    const transport: Transport = async (url, opts) => {
+      if (String(url).includes('typesafe.ai')) observed.push(JSON.parse(String(opts?.body)));
+      return mock(extraction(lines.map(text => ({ text, evidence: text }))),
+        jev(['public', 'public', 'public', 'hr-payroll', 'vault'], answer('public')), document)(url, opts);
+    };
+    const facts = await classifyDocument({ text: document, sourceId: 'fictional-meeting' }, transport);
+    expect(observed[1]?.state).toEqual({ context_label: label });
+    expect((observed[1]?.questions as Record<string, unknown>).context_label).toBeDefined();
+    const pages = planScopedPages('fictional-meeting', document, facts);
+    const shared = pages.filter(page => page.sourceId === 'mvp-shared');
+    expect(shared).toHaveLength(3);
+    for (const page of shared) {
+      expect(page.content).toContain('Context: Lantern Forge coordination meeting');
+      expect(page.content).not.toContain('GARNET-LOOM-31');
+      expect(page.content).not.toContain('AMBER-HERON-28');
+    }
+    expect(pages.find(page => page.sourceId === 'mvp-hr-payroll')?.content).not.toContain('Context:');
+  });
+
+  test('private or uncertain title never enters shared pages', async () => {
+    const title = 'Secret Juniper acquisition meeting';
+    const document = `Meeting: ${title}\nLunch on Friday is public.\nHR case GARNET-LOOM-31 is confidential.`;
+    const label = { text: title, evidence: `Meeting: ${title}` };
+    const facts = ['Lunch on Friday is public.', 'HR case GARNET-LOOM-31 is confidential.'];
+    for (const verdict of [answer('vault'), answer('public', 0.6)]) {
+      const classified = await classifyDocument({ text: document, sourceId: 'private-title' },
+        mock(extraction(facts.map(text => ({ text, evidence: text }))),
+          jev(['public', 'hr-payroll'], verdict), document));
+      const pages = planScopedPages('private-title', document, classified);
+      expect(pages.find(page => page.sourceId === 'mvp-shared')?.content).toContain('Lunch on Friday');
+      expect(pages.find(page => page.sourceId === 'mvp-shared')?.content).not.toContain(title);
+    }
+  });
+
+  test('malformed or missing title classification refuses the entire publication plan', async () => {
+    const document = 'Meeting: Lantern Forge\nLunch is public.';
+    const extracted = extraction([{ text: 'Lunch is public.', evidence: 'Lunch is public.' }]);
+    let publicationStarted = false;
+    async function classifyThenPlan(transport: Transport) {
+      const facts = await classifyDocument({ text: document, sourceId: 'candidate' }, transport);
+      publicationStarted = true;
+      return planScopedPages('candidate', document, facts);
+    }
+    await expect(classifyThenPlan(mock(extracted, jev(['public']), document))).rejects.toThrow('Incomplete');
+    expect(publicationStarted).toBe(false);
+    const malformed = jev(['public'], answer('public'));
+    malformed.answers.context_label = { ...answer('public'), confidence: Number.NaN };
+    await expect(classifyThenPlan(mock(extracted, malformed, document))).rejects.toThrow('Malformed');
+    expect(publicationStarted).toBe(false);
+  });
+});
diff --git a/test/scopes-identity.test.ts b/test/scopes-identity.test.ts
new file mode 100644
index 00000000..33501620
--- /dev/null
+++ b/test/scopes-identity.test.ts
@@ -0,0 +1,90 @@
+import { afterAll, beforeAll, describe, expect, test } from 'bun:test';
+import { mkdtemp, readFile, rm, stat } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { PGLiteEngine } from '../src/core/pglite-engine.ts';
+import { GBrainOAuthProvider } from '../src/core/oauth-provider.ts';
+import { sqlQueryForEngine } from '../src/core/sql-query.ts';
+import { provisionDemo, type DemoProvisioningResult } from '../src/core/scopes/identity.ts';
+import { registerLocalWriter } from '../src/core/persistence/identity.ts';
+import { withEnv } from './helpers/with-env.ts';
+
+describe('provisionDemo', () => {
+  let engine: PGLiteEngine;
+  let home: string;
+  let result: DemoProvisioningResult;
+
+  beforeAll(async () => {
+    home = await mkdtemp(join(tmpdir(), 'gbrain-scopes-identity-'));
+    engine = new PGLiteEngine();
+    await engine.connect({});
+    await engine.initSchema();
+    await engine.setConfig('embedding_enabled', 'false');
+    await withEnv({ GBRAIN_HOME: home }, async () => {
+      await engine.executeRaw('UPDATE persistence_brain SET enabled=true WHERE singleton=1');
+      await registerLocalWriter(engine, 'cli');
+      result = await provisionDemo(engine, 'http://127.0.0.1:3131/mcp');
+    });
+  });
+
+  afterAll(async () => {
+    await engine.disconnect();
+    await rm(home, { recursive: true, force: true });
+  });
+
+  test('creates isolated sources and three least-privilege machine clients', async () => {
+    await withEnv({ GBRAIN_HOME: home }, async () => {
+      expect(result.sources).toEqual(['mvp-shared', 'mvp-hr-payroll', 'mvp-juniper', 'mvp-vault']);
+      expect(result.members.map(({ name, sourceIds }) => ({ name, sourceIds }))).toEqual([
+        { name: 'Iris', sourceIds: ['mvp-shared'] },
+        { name: 'Elena', sourceIds: ['mvp-shared', 'mvp-hr-payroll'] },
+        { name: 'Ben', sourceIds: ['mvp-shared', 'mvp-juniper'] },
+      ]);
+      expect(await engine.getConfig('facts.extraction_enabled')).toBe('false');
+      expect(await engine.getConfig('embedding_enabled')).toBe('false');
+
+      const sourceRows = await engine.listAllSources();
+      const demoSources = sourceRows.filter(({ id }) => result.sources.includes(id));
+      expect(demoSources.map(({ id, local_path }) => ({ id, local_path })).sort((a, b) => a.id.localeCompare(b.id))).toEqual(
+        result.sources.map(id => ({ id, local_path: join(home, '.scoped', 'content', id) })).sort((a, b) => a.id.localeCompare(b.id)),
+      );
+      expect(demoSources.every(source => source.config.federated === false)).toBe(true);
+
+      const sql = sqlQueryForEngine(engine);
+      const clients = await sql`SELECT client_id, client_name, scope, source_id, federated_read, surface FROM oauth_clients ORDER BY client_name`;
+      expect(clients).toHaveLength(3);
+      const byName = new Map(clients.map(client => [client.client_name, client]));
+      for (const member of result.members) {
+        const path = member.credentialPath;
+        const file = JSON.parse(await readFile(path, 'utf8'));
+        expect(Object.keys(file).sort()).toEqual(['clientId', 'clientSecret', 'url']);
+        expect(file.url).toBe('http://127.0.0.1:3131/mcp');
+        expect((await stat(path)).mode & 0o777).toBe(0o600);
+        const client = byName.get(`mvp-${member.name.toLowerCase()}`)!;
+        expect(client.scope).toBe('read');
+        expect(client.source_id).toBe('mvp-shared');
+        expect(client.federated_read).toEqual(member.sourceIds);
+        expect(client.surface).toBe('starter');
+        const provider = new GBrainOAuthProvider({ sql, transaction: fn => engine.transaction(tx => fn(sqlQueryForEngine(tx))) });
+        const token = await provider.exchangeClientCredentials(file.clientId, file.clientSecret);
+        expect(token.token_type).toBe('bearer');
+        expect(token.scope).toBe('read');
+      }
+    });
+  });
+
+  test('refuses to reuse an existing demo identity without modifying records', async () => {
+    await withEnv({ GBRAIN_HOME: home }, async () => {
+      const before = await engine.listAllSources();
+      await expect(provisionDemo(engine)).rejects.toThrow(/source IDs already exist/);
+      expect(await engine.listAllSources()).toEqual(before);
+    });
+  });
+
+  test('registers content roots through managed source lifecycle', async () => {
+    const bindings = await Promise.all(result.sources.map(id => engine.executeRaw<{ source_id: string }>(
+      'SELECT source_id FROM persistence_source_bindings WHERE source_id=$1', [id],
+    )));
+    expect(bindings.every(rows => rows.length === 1)).toBe(true);
+  });
+});
