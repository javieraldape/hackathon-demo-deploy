+    expect((await ingress({ ...event, media: [{ contentType: 'application/pdf', path: '/invalid' }] }, trusted)).reply.text).toContain('.txt');
+    expect((await ingress({ ...event, body: 'not stored', media: [{}, {}] }, trusted)).handled).toBe(true);
